# --- Auth (added for httpOnly cookie migration) ---
# Freshly generated. The previous secret was a hardcoded literal committed to git,
# so it must not be reused. Rotating it invalidates old tokens - harmless here,
# since moving the token to a cookie logs everyone out once anyway.
JWT_SECRET=adC9SR1L984jRRf-Y7N7_h1PNRRBhRJSMCh3D3-JCv5YOMVUGdTD2w2Sp0sN4nfz

# Controls the cookie Secure flag: set to "production" only when served over HTTPS.
NODE_ENV=development

# Exact origins allowed to send credentialed requests. Comma-separated.
# Must be explicit - a wildcard origin with credentials is rejected by browsers.
CORS_ORIGIN=http://localhost:5173
